# ChapterScope AI - React frontend environment template
# Copy to frontend/.env and adjust. frontend/.env is gitignored.
#
# Only REACT_APP_* variables are exposed to the browser bundle.
# NEVER put backend secrets here (SECRET_KEY, GEMINI_API_KEY, DB URLs) -
# anything in this file ships to every visitor.

# Legacy report/prediction API. The FastAPI report routes are mounted under
# /api/reports/* and run on port 8001.
REACT_APP_REPORTS_API_URL=http://localhost:8001

# Notebook/auth requests intentionally use relative URLs so CRA proxies them
# to Django on port 8000. Do not set this to the FastAPI host.
# REACT_APP_API_URL=http://localhost:8000

# Optional UI flags
REACT_APP_ENABLE_DEBUG=true
