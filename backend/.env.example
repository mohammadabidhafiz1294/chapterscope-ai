# EduQuantum / ChapterScope AI - backend environment template
# Copy to backend/.env and adjust. backend/.env is gitignored.
# All values below are placeholders. Real environment variables always
# override values loaded from this file.

# --- Django core -----------------------------------------------------------
# In development (DEBUG=True) an ephemeral SECRET_KEY is generated when unset.
# Production (DEBUG=False) refuses to start without a real SECRET_KEY,
# ALLOWED_HOSTS and DATABASE_URL.
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# SQLite (local development default - no server required):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL / Supabase (production). Driver options go in the query string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# MySQL:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Test runs can point anywhere without touching the dev DB, e.g.:
# DATABASE_URL=sqlite:////tmp/chapterscope_test.db

# --- AI services -----------------------------------------------------------
# Leave empty to run without Gemini; AI-backed endpoints return 503.
GEMINI_API_KEY=
QISKIT_BACKEND=aer_simulator

# --- Uploads ---------------------------------------------------------------
# 10 MB in bytes
MAX_FILE_SIZE=10485760

# --- Phase 3: extraction / OCR ---------------------------------------------
# Source-traceable processing of syllabus and exam-paper files.
EXTRACTION_MAX_PAGES=300
EXTRACTION_MAX_CHARS=2000000
EXTRACTION_MAX_DOCX_UNCOMPRESSED=52428800
# PDF pages with fewer non-whitespace chars than this are flagged low-text
# (likely scanned); with no OCR engine available the run returns OCR_REQUIRED.
EXTRACTION_OCR_MIN_CHARS=40
# OCR results / questions below these confidences are marked NEEDS_REVIEW.
EXTRACTION_OCR_MIN_CONFIDENCE=0.6
EXTRACTION_REVIEW_CONFIDENCE=0.7
# Stale PROCESSING runs older than this (minutes) can be retried.
EXTRACTION_STALE_MINUTES=15
# LLM-assisted parsing fallback (only used when GEMINI_API_KEY is set).
EXTRACTION_ENABLE_LLM_FALLBACK=true
# OCR engine: auto (use if installed, else OCR_REQUIRED), none, or tesseract.
# Local OCR is optional: install pytesseract + pdf2image + system
# tesseract-ocr and poppler-utils; nothing here calls a paid OCR API.
OCR_ENGINE=auto

# --- Phase 4: RAG search ---------------------------------------------------
# Vector search needs PostgreSQL + pgvector (`CREATE EXTENSION IF NOT EXISTS
# vector`). On SQLite the endpoint answers 503 `vector_backend_unavailable`
# while chunk rows, indexing and validation keep working.
EMBEDDING_ENABLED=true
# gemini = google-genai. Needs GEMINI_API_KEY in this file; a missing key
# answers 503 `embedding_unavailable` and is never replaced with a fake one.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Must match the stored vector column. After changing it, drop and rebuild the
# (regenerable) vectors with `manage.py index_rag --reset-vectors`; document
# text and provenance are never touched.
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE_DOCUMENT=RETRIEVAL_DOCUMENT
EMBEDDING_TASK_TYPE_QUERY=RETRIEVAL_QUERY
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_TEXT_CHARS=8000
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2
# Re-index automatically after every successful extraction run.
EMBEDDING_AUTO_INDEX=true
# Retrieval: candidate pool, rank fusion, snippet and per-query time budget.
RAG_TOP_K=8
RAG_MAX_TOP_K=20
RAG_CANDIDATE_MULTIPLIER=3
RAG_FUSION_ENABLED=true
RAG_RRF_K=60
# Minimum cosine similarity (0.0 = drop only anti-correlated passages).
RAG_MIN_SCORE=0.0
RAG_MAX_QUERY_CHARS=500
RAG_SNIPPET_CHARS=400
RAG_QUERY_TIMEOUT_SECONDS=5

# --- Phase 5: course analytics --------------------------------------------
# Multi-topic allocation weight for weighting="weighted" (primary counts are
# unaffected): each secondary counts this much of a primary question.
ANALYTICS_SECONDARY_WEIGHT=0.5
# Most-recent distinct years in the "recent frequency" window (>=1).
ANALYTICS_RECENT_YEARS=3
# Paper-prevalence slope per year that maps to the neutral trend term.
ANALYTICS_TREND_CAP=0.25
# Ranking weights (renormalised by their sum in the reported score).
ANALYTICS_WEIGHT_FREQUENCY=0.35
ANALYTICS_WEIGHT_RECENCY=0.25
ANALYTICS_WEIGHT_TREND=0.2
ANALYTICS_WEIGHT_SYLLABUS=0.2
# Response bounds: series topics / table rows.
ANALYTICS_TREND_TOPICS=8
ANALYTICS_MAX_TOPICS=20
# Label proposals (LLM optional; use_llm=false still works without a key).
TOPIC_LLM_ENABLED=true
TOPIC_LLM_MODEL=gemini-2.5-flash
TOPIC_LLM_TIMEOUT_SECONDS=20
# Proposals at/below this confidence are stored as NEEDS_REVIEW (0..1).
TOPIC_REVIEW_MIN_CONFIDENCE=0.75
# Questions per proposal request (hard cap).
TOPIC_LLM_MAX_QUESTIONS=20

# --- Phase 6: notebook chat (LangChain) -------------------------------------
# Chat is optional like TOPIC_LLM_*: disabled, or with no GEMINI_API_KEY, a
# POST fails fast with 503 chat_unavailable before anything is written.
CHAT_LLM_ENABLED=true
# Implemented provider: google_genai (ChatGoogleGenerativeAI).
CHAT_LLM_PROVIDER=google_genai
CHAT_LLM_MODEL=gemini-2.5-flash
CHAT_LLM_TEMPERATURE=0.2
CHAT_LLM_MAX_OUTPUT_TOKENS=1024
CHAT_LLM_TIMEOUT_SECONDS=20
# Request/response bounds.
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_ANSWER_CHARS=4000
# Recent USER/ASSISTANT turns replayed as prompt context.
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_CHARS=4000
# Total budget for retrieved source blocks in the prompt.
CHAT_CONTEXT_CHARS=6000
# Retrieval settings for the chat query (clamped against the RAG limits).
CHAT_RETRIEVAL_TOP_K=5
CHAT_RETRIEVAL_MIN_SCORE=0.0
CHAT_RETRIEVAL_KEYWORD=true
CHAT_RETRIEVAL_QUERY_CHARS=500
# Server-side citation filter: only retrieved source_keys survive.
CHAT_MAX_CITATIONS=5

# --- Phase 7: practice-question generation ---------------------------------
# Generation is optional like chat: disabled, or with no GEMINI_API_KEY, a
# POST fails fast with 503 generation_unavailable before anything is written.
GENERATION_LLM_ENABLED=true
# Implemented provider: google_genai (ChatGoogleGenerativeAI).
GENERATION_LLM_PROVIDER=google_genai
GENERATION_LLM_MODEL=gemini-2.5-flash
GENERATION_LLM_TEMPERATURE=0.4
GENERATION_LLM_MAX_OUTPUT_TOKENS=4096
GENERATION_LLM_TIMEOUT_SECONDS=30
# Request/response bounds and validation thresholds.
GENERATION_MAX_QUESTIONS=20
GENERATION_MAX_SOURCE_REFS=8
GENERATION_CONTEXT_CHARS=6000
GENERATION_SCHEMA_RETRIES=1
GENERATION_DUPLICATE_THRESHOLD=0.85
GENERATION_MIN_CONFIDENCE=0.6
GENERATION_NUMERIC_TOLERANCE=1e-6

# --- CORS / CSRF -----------------------------------------------------------
# Comma-separated origins. Development falls back to localhost:3000/8001
# when unset; with DEBUG=False this must be set explicitly (empty = deny).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origins allowed to POST cross-site (e.g. frontend behind a proxy):
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- HTTPS / cookies -------------------------------------------------------
# Defaults are safe for production (True when DEBUG=False) and relaxed in
# development. Set these to False only for local non-TLS runs.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
# Set X_FRAME_OPTIONS=DENY in production (the settings default is DENY).
# Behind TLS terminators (Supabase, nginx) that set X-Forwarded-Proto:
# SECURE_PROXY_SSL_HEADER=true

# --- Private storage -------------------------------------------------------
# The current application uses Django MEDIA_ROOT, protected by owner-scoped
# API file endpoints. Do not expose MEDIA_ROOT as a public bucket. If object
# storage is introduced, use a private bucket and short-lived signed URLs
# generated only by the backend; never expose service-role credentials here.
